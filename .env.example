# ComicCraft AI Configuration

# Development Mode (Set to true to run without API keys or local GPU)
MOCK_AI=true

# Google Gemini API Settings
GEMINI_API_KEY=your_gemini_api_key_here
# Configurable models (e.g. gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_OUTLINE_MODEL=gemini-1.5-flash
GEMINI_STORY_MODEL=gemini-1.5-pro

# Image Generation Settings
# Provider options: "huggingface", "local" (diffusers), or "mock"
IMAGE_PROVIDER=huggingface
HF_API_KEY=your_huggingface_api_key_here
HF_IMAGE_MODEL=runwayml/stable-diffusion-v1-5

# Directory Paths (Relative to project root)
OUTPUT_DIR=static
PANELS_DIR=static/panels
EXPORTS_DIR=static/exports

# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=true
